{
  "name": "leave-management-server",
  "version": "1.0.0",
  "description": "Role-based Leave Management System backend (Express, MongoDB, Mongoose)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeds/seed.js",
    "create-admin": "node src/seeds/createAdmin.js",
    "check": "node scripts/check-imports.js",
    "postman": "node scripts/generate-postman.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"src/tests/unit/*.test.js\"",
    "test:integration": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.0",
    "zod": "^4.0.0",
    "cloudinary": "^2.5.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}